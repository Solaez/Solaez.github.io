  "archivoPrincipal": "index.html",
  "codigo": "<!doctype html>\n<html lang=\"es\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Configurator Hyprland</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <div id=\"app-container\">\n      <aside class=\"sidebar\">\n        <div class=\"brand\">\n          <span class=\"icon\">⚙</span>\n          <h2>CONFIG</h2>\n        </div>\n        <nav class=\"menu\">\n          <button class=\"nav-item active\"><span class=\"icon\">🖥</span> Pantalla</button>\n          <button class=\"nav-item\"><span class=\"icon\">🖱</span> Mouse</button>\n          <button class=\"nav-item\"><span class=\"icon\">⌨</span> Teclado</button>\n          <button class=\"nav-item\"><span class=\"icon\">⌘</span> Atajos</button>\n          <button class=\"nav-item\"><span class=\"icon\">📡</span> Red y Conexión</button>\n          <button class=\"nav-item\"><span class=\"icon\">🔊</span> Audio y Sonido</button>\n          <button class=\"nav-item\"><span class=\"icon\">🔒</span> Privacidad y Seguridad</button>\n          <button class=\"nav-item\"><span class=\"icon\">👤</span> Cuentas de Usuario</button>\n          <button class=\"nav-item\"><span class=\"icon\">⚡</span> Energía y Batería</button>\n          <button class=\"nav-item\"><span class=\"icon\">🛠</span> Herramientas del Sistema</button>\n          <button class=\"nav-item\"><span class=\"icon\">🕒</span> Fecha y Hora</button>\n          <button class=\"nav-item\"><span class=\"icon\">🧩</span> Extensiones</button>\n          <button class=\"nav-item\"><span class=\"icon\">ℹ</span> Información del Sistema</button>\n        </nav>\n        <footer class=\"version\">UNKNOWN v0.1.7</footer>\n      </aside>\n      <main class=\"main-content\">\n        <h1>Pantalla</h1>\n        <div class=\"config-layout\">\n          <div class=\"config-card\">\n            <div class=\"display-selector\">\n              <div class=\"display-box active\">\n                <span class=\"name\">eDP-1</span>\n                <span class=\"res\">1920x1080</span>\n              </div>\n              <div class=\"display-box\">\n                <span class=\"name\">HDMI-A-1</span>\n                <span class=\"res\">1920x1080</span>\n              </div>\n            </div>\n            <div class=\"setting-group\">\n              <label>Monitor: eDP-1</label>\n              <h3>Pantalla Principal</h3>\n              <select id=\"monitor-select\">\n                <option>eDP-1 - 1920x1080</option>\n              </select>\n            </div>\n            <div class=\"setting-group\">\n              <label>Resolución</label>\n              <select id=\"resolution-select\">\n                <option>3840x2160@120.11Hz</option>\n              </select>\n            </div>\n            <div class=\"setting-group\">\n              <label>Rotación</label>\n              <select id=\"rotation-select\">\n                <option>Normal</option>\n              </select>\n            </div>\n            <div class=\"setting-group\">\n              <label>Escalado</label>\n              <input type=\"range\" min=\"50\" max=\"200\" value=\"100\" />\n              <span class=\"scale-value\">100%</span>\n            </div>\n            <button class=\"btn-apply\">APLICAR CAMBIOS</button>\n          </div>\n          <div class=\"preview-card\">\n            <div class=\"preview-box\">\n              <div class=\"monitor-screen\"></div>\n            </div>\n            <span class=\"preview-label\">VISTA PREVIA</span>\n          </div>\n        </div>\n      </main>\n    </div>\n    <script type=\"module\" src=\"renderer.js\"></script>\n  </body>\n</html>"
}
